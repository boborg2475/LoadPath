{
  "version": 6,
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "Visual Studio 2022, x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc"
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "msvc", "configuration": "Debug",   "jobs": 8 },
    { "name": "release", "configurePreset": "msvc", "configuration": "Release", "jobs": 8 }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "msvc", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "msvc", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
